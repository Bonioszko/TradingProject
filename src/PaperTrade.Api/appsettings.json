{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MessagingReliability": {
    "RecoveryDelay": "00:00:02",
    "ConnectTimeout": "00:00:03",
    "PublishTimeout": "00:00:05",
    "ShutdownGracePeriod": "00:00:30"
  },
  "TradingReliability": {
    "StaleOutboxWarning": "00:05:00",
    "Outbox": {
      "PollInterval": "00:00:00.250",
      "BatchSize": 20,
      "LeaseDuration": "00:00:30",
      "MaximumAttempts": 8,
      "InitialRetryDelay": "00:00:01",
      "MaximumRetryDelay": "00:01:00"
    },
    "Retention": {
      "Enabled": true,
      "CleanupInterval": "01:00:00",
      "PublishedOutboxRetention": "7.00:00:00",
      "InboxRetention": "30.00:00:00"
    }
  },
  "AllowedHosts": "*"
}
